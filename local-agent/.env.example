# Folder the agent is allowed to touch. Everything outside is blocked.
WORKSPACE_DIR=./workspace
# Required: all requests must send  Authorization: Bearer <token>
AGENT_TOKEN=change-me-to-a-long-random-string
PORT=8787
# Optional: enables POST /agent (natural-language instructions)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Commands that run without asking (first word only, comma-separated)
AUTO_APPROVE=python3,python,node,npm,npx,pip,pip3,ls,cat,echo,pwd,git,mkdir,touch
COMMAND_TIMEOUT_MS=30000

# Browser (Phase 2). Set BROWSER_HEADLESS=false to watch it work.
BROWSER_HEADLESS=true
# Optional allowlist; empty = any http(s) site. Subdomains match. e.g. 127.0.0.1,example.com
BROWSER_ALLOWED_DOMAINS=
